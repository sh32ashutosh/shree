# Saubhagya Sarees - Environment Configuration
# Copy this file to .env.local for local development

# ─── DATABASE ──────────────────────────────────────────────────────────────
# SQLite for development (file-based, zero config)
DATABASE_URL="file:./dev.db"

# For production PostgreSQL, use:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saubhagya_sarees?schema=public"

# ─── AUTHENTICATION ────────────────────────────────────────────────────────
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING_IN_PRODUCTION"
AUTH_URL="http://localhost:3000"

# ─── STORE CONFIGURATION ───────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="Saubhagya Sarees"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# Demo mode — disables real payment verification when true
NEXT_PUBLIC_DEMO_MODE="true"

# ─── PAYMENT GATEWAY ───────────────────────────────────────────────────────
# Razorpay (Indian payment gateway - https://razorpay.com)
# Leave commented to run in demo mode
# RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
# RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXX"
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"

# ─── EMAIL PROVIDER ────────────────────────────────────────────────────────
# Resend (https://resend.com) — for transactional emails
# RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"
# EMAIL_FROM="noreply@saubhagyasarees.com"

# Or use SMTP:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="your-app-password"

# ─── FILE STORAGE ──────────────────────────────────────────────────────────
# Cloudinary (for product images)
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# Or AWS S3:
# AWS_S3_BUCKET="saubhagya-sarees-media"
# AWS_S3_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID="XXXXXXXXXXXXXXXXX"
# AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXX"

# ─── SHIPPING PROVIDER ─────────────────────────────────────────────────────
# Shiprocket (Indian logistics - https://shiprocket.in)
# SHIPROCKET_EMAIL="your@email.com"
# SHIPROCKET_PASSWORD="your_password"
# SHIPROCKET_CHANNEL_ID="your_channel_id"

# ─── MONITORING ────────────────────────────────────────────────────────────
# Sentry (error tracking)
# SENTRY_DSN="https://XXXX@sentry.io/XXXX"

# ─── FIRST ADMIN BOOTSTRAP ─────────────────────────────────────────────────
# Used ONLY by the seed script to create the first super admin
# Remove these after initial setup
SEED_ADMIN_EMAIL="admin@saubhagyasarees.com"
SEED_ADMIN_PASSWORD="CHANGE_THIS_BEFORE_SEEDING"
SEED_ADMIN_NAME="Atelier Director"
